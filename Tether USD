                </a>
                
                <a href="https://tronscan.org/#/contract/TFqSRX1VUJK5MMzgUC2omVb2n8zdBF3KMz" target="_blank" class="action-btn">
                    <i class="fas fa-search"></i> TRONSCAN
                </a>
            </div>
            
            <div class="sunswap-buttons">
                <a href="https://sunswap.com/#/swap?outputCurrency=TFqSRX1VUJK5MMzgUC2omVb2n8zdBF3KMz" target="_blank" class="sunswap-btn">
