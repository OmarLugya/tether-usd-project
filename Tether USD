                        <i class="fas fa-exchange-alt"></i> Trade on SunSwap
                    </a>
                    <a href="https://tronscan.org/#/contract/TFqSRX1VUJK5MMzgUC2omVb2n8zdBF3KMz" target="_blank" class="btn-secondary">
                        <i class="fas fa-search"></i> View on TRONSCAN
                    </a>
                </div>
            </div>
            
            <div class="token-card">
                <div class="token-header">
                    <div class="token-logo">₮</div>
                    <div class="token-info">
                        <h3>Tether USD</h3>
                        <p>TRC20 • 6 Decimals</p>
                    </div>
                </div>
                <div class="token-detail">
                    <span>Contract</span>
                    <span class="detail-value">TC44...h1m</span>
                </div>
                <div class="token-detail">
                    <span>Network</span>
                    <span class="detail-value">TRON</span>
                </div>
            </div>
        </section>
        
        <section class="features" id="features">
            <div class="feature-card">
                <div class="feature-icon"><i class="fas fa-ban"></i></div>
                <h4>Blacklist</h4>
