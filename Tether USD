                <a href="https://sunswap.com/#/add/TRX/TFqSRX1VUJK5MMzgUC2omVb2n8zdBF3KMz" target="_blank" class="sunswap-btn">
                    <i class="fas fa-water"></i> 💧 Provide Liquidity
                </a>
            </div>
            
            <div id="status"></div>
            
            <div class="contract-address" id="contract">
                <code>TFqSRX1VUJK5MMzgUC2omVb2n8zdBF3KMz</code>
                <button class="copy-btn" onclick="copyAddress()"><i class="fas fa-copy"></i> Copy</button>
            </div>
            
            <div style="margin-top: 20px; font-size: 14px; color: #888;">
                <i class="fas fa-exclamation-triangle" style="color: #f59e0b;"></i>
                Academic Project • No Monetary Value • For Educational Purposes Only
            </div>
        </section>
        
        <footer class="footer">
            <p>© 2026 Tether USD Academic Project • Created by Omar Lugya Mohamed</p>
            <p>📧 <a href="mailto:lugyao40@gmail.com" class="footer-email">lugyao40@gmail.com</a></p>
            <p>🔗 <a href="https://github.com/OmarLugya" class="footer-email">@OmarLugya</a></p>
        </footer>
    </div>

    <script>
        const CONTRACT = "TFqSRX1VUJK5MMzgUC2omVb2n8zdBF3KMz";
        
        function copyAddress() {
            navigator.clipboard.writeText(CONTRACT).then(() => {
                const btn = document.querySelector('.copy-btn');
                const originalText = btn.innerHTML;
                btn.innerHTML = '✅ Copied!';
                setTimeout(() => btn.innerHTML = originalText, 2000);
            });
        }
    </script>
</body>
</html>
