            </div>
        </section>
        
        <section class="actions" id="actions">
            <h3 style="font-size: 36px; margin-bottom: 20px;">Token Actions</h3>
            <p>Trade or add liquidity on SunSwap</p>
            
            <div class="action-buttons">
                <a href="https://sunswap.com/#/swap?outputCurrency=TFqSRX1VUJK5MMzgUC2omVb2n8zdBF3KMz" target="_blank" class="action-btn">
                    <i class="fas fa-exchange-alt"></i> Trade on SunSwap
                </a>
                
                <a href="https://sunswap.com/#/add/TRX/TFqSRX1VUJK5MMzgUC2omVb2n8zdBF3KMz" target="_blank" class="action-btn">
